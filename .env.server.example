# Copy this file outside the repository, replace every placeholder, then run:
# chmod 600 /absolute/path/to/it-useful-server.env
APP_PUBLIC_BASE_URL=https://it-useful.example.com
DB_NAME=it_useful
DB_USER=it_useful
DB_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
FRONTEND_PORT=3000
# Optional email delivery of invitation and reset links. Leave these commented
# out to copy links by hand. For a Microsoft 365 relay connector that trusts the
# server's IP, use the tenant's MX host on port 25 without a username.
# SMTP_HOST=company-com.mail.protection.outlook.com
# SMTP_PORT=25
# SMTP_FROM=it-useful@company.com
# SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
