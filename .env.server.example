# Copy this file outside the repository, replace every placeholder, then run:
# chmod 600 /absolute/path/to/it-useful-server.env
APP_PUBLIC_BASE_URL=https://server.tailnet-name.ts.net
APP_OWNER_GITHUB_ID=replace-with-numeric-github-id
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
DB_NAME=it_useful
DB_USER=it_useful
DB_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
FRONTEND_PORT=3000
